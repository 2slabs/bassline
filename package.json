{
  "name": "bassline",
  "version": "0.1.0",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && tsx build.ts --production",
    "build:dev": "npm run typecheck && tsx build.ts",
    "start": "npm run build:dev && ableton-extensions-cli run",
    "package": "npm run build && ableton-extensions-cli package",
    "typecheck": "tsc && tsc -p ui",
    "test": "node --import tsx --test test/*.test.ts",
    "ui": "vite --open /interface.html"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "private": true,
  "description": "Bassline generator for Ableton Live: from a chord/melody clip or from scratch, for techno, dub techno and house."
}
